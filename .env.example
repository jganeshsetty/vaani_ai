# VaaniCall AI backend configuration
# Copy to .env and fill in real credentials before deploying.

# MongoDB
VAANI_MONGODB_URI=mongodb://localhost:27017
VAANI_MONGODB_DB=vaani_ai

# Exotel Connect Voice AI
VAANI_EXOTEL_API_KEY=
VAANI_EXOTEL_TOKEN=
VAANI_EXOTEL_BASE_URL=https://api.exotel.com/v1
VAANI_EXOTEL_VOICE_AI_SID=
VAANI_EXOTEL_MEDIA_WS_PATH=/media

# Gnani.ai AI Voice (Unified API key covers both Prisma STT & Timbre TTS)
VAANI_GNANI_API_KEY=

# Server
VAANI_HOST=0.0.0.0
VAANI_PORT=8000

# CORS (comma-separated origins, or * for all)
VAANI_CORS_ORIGINS=*