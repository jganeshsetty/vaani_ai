# Vaani AI Backend Configuration
# Copy to .env and fill in real credentials before deploying.
# See README.md for setup instructions.

# =============================================================================
# MongoDB Configuration
# =============================================================================
# For local development: mongodb://localhost:27017
# For GCP Cloud SQL / MongoDB Atlas: use the full connection string
VAANI_MONGODB_URI=mongodb://localhost:27017
VAANI_MONGODB_DB=vaani_ai

# =============================================================================
# Hugging Face API (Evon v3.3)
# =============================================================================
# Get API key from: https://huggingface.co/settings/tokens
# Evon v3.3 is a 30B parameter AI voice model
VAANI_HUGGINGFACE_API_KEY=

# =============================================================================
# Gnani.ai Speech APIs (STT & TTS)
# =============================================================================
# Unified API key covers both Prisma (Speech-to-Text) and Timbre (Text-to-Speech)
# Get API key from: https://gnani.ai/developer-dashboard
VAANI_GNANI_API_KEY=

# =============================================================================
# Meta WhatsApp API
# =============================================================================
# Configure in Meta Developer Console: https://developers.facebook.com/docs/whatsapp/cloud-api
VAANI_WHATSAPP_PHONE_NUMBER_ID=
VAANI_WHATSAPP_ACCESS_TOKEN=

# =============================================================================
# Google Cloud Platform (GCP)
# =============================================================================
# GCP Project ID from Google Cloud Console
VAANI_GCP_PROJECT_ID=
# GCS bucket name for audio storage (must be created in GCP Console)
VAANI_GCS_BUCKET_NAME=
# Path to service account JSON key file (for local dev only)
# For Cloud Run, use workload identity or upload key to secrets manager
VAANI_GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# Server Configuration
# =============================================================================
VAANI_HOST=0.0.0.0
VAANI_PORT=8000

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated origins for CORS, or * for all
VAANI_CORS_ORIGINS=*